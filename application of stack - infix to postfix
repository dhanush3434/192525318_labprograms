#include <stdio.h>
#include <ctype.h>

#define MAX 100

char stack[MAX];
int top = -1;

/* PUSH */
void push(char ch)
{
    stack[++top] = ch;
}

/* POP */
char pop()
{
    return stack[top--];
}

/* Return precedence of operator */
int precedence(char ch)
{
    if(ch == '^')
        return 3;

    if(ch == '*' || ch == '/')
        return 2;

    if(ch == '+' || ch == '-')
        return 1;

    return 0;
}

/* Convert Infix to Postfix */
void infixToPostfix(char infix[], char postfix[])
{
    int i = 0, j = 0;
    char ch;

    while(infix[i] != '\0')
    {
        ch = infix[i];

        /* If operand, add to postfix */
        if(isalnum(ch))
        {
            postfix[j++] = ch;
        }

        /* If opening bracket */
        else if(ch == '(')
        {
            push(ch);
        }

        /* If closing bracket */
        else if(ch == ')')
        {
            while(top != -1 && stack[top] != '(')
            {
                postfix[j++] = pop();
            }

            pop();   // Remove '('
        }

        /* If operator */
        else
        {
            while(top != -1 &&
                  stack[top] != '(' &&
                  precedence(stack[top]) >= precedence(ch))
            {
                postfix[j++] = pop();
            }

            push(ch);
        }

        i++;
    }

    /* Pop remaining operators */
    while(top != -1)
    {
        postfix[j++] = pop();
    }

    postfix[j] = '\0';
}

int main()
{
    char infix[MAX], postfix[MAX];

    printf("Enter infix expression: ");
    scanf("%s", infix);

    infixToPostfix(infix, postfix);

    printf("Postfix expression: %s\n", postfix);

    return 0;
}
